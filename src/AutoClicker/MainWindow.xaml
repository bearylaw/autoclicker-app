<Window x:Class="AutoClicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoClicker"
        Width="440" Height="822"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgWindow}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Fill" Value="{StaticResource TextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource Accent}" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Pulse">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.25" Duration="0:0:0.6"
                                                 AutoReverse="True" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Pulse" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrushStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ======================= Title bar ======================= -->
            <Grid Grid.Row="0" Height="46" Background="{StaticResource BgWindow}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Rectangle Width="4" Height="18" RadiusX="2" RadiusY="2" Fill="{StaticResource Accent}" />
                    <TextBlock Text="AUTOCLICKER" Foreground="{StaticResource TextPrimary}"
                               FontSize="13" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="1.0" Foreground="{StaticResource TextMuted}"
                               FontSize="11" Margin="8,1,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click"
                            ToolTip="Minimize" />
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click"
                            ToolTip="Close" />
                </StackPanel>
            </Grid>

            <!-- ======================== Content ======================== -->
            <StackPanel Grid.Row="1" Margin="18,2,18,0">

                <!-- Status -->
                <Border Style="{StaticResource Card}" Padding="18,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,14,0"
                                 VerticalAlignment="Center" Style="{StaticResource StatusDot}" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="{Binding StatusDetail}" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="6"
                                Background="{StaticResource AccentSoft}" Padding="9,4"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ActiveModeLabel}" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource Accent}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Speed -->
                <TextBlock Text="CLICK SPEED" Style="{StaticResource SectionLabel}" Margin="2,18,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Slider Grid.Column="0" x:Name="SpeedSlider" Style="{StaticResource AccentSlider}"
                                    Minimum="1" Maximum="100" SmallChange="1" LargeChange="5"
                                    VerticalAlignment="Center" Margin="0,0,16,0"
                                    ValueChanged="SpeedSlider_ValueChanged" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="CpsBox" Style="{StaticResource NumericBox}" Width="72"
                                         MaxLength="6"
                                         Text="{Binding CpsText, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewKeyDown="CpsBox_PreviewKeyDown"
                                         LostFocus="CpsBox_LostFocus" />
                                <TextBlock Text="CPS" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PresetChip}" Content="5" Click="Preset_Click" Tag="5" />
                                <Button Style="{StaticResource PresetChip}" Content="10" Click="Preset_Click" Tag="10" />
                                <Button Style="{StaticResource PresetChip}" Content="25" Click="Preset_Click" Tag="25" />
                                <Button Style="{StaticResource PresetChip}" Content="50" Click="Preset_Click" Tag="50" />
                                <Button Style="{StaticResource PresetChip}" Content="100" Click="Preset_Click" Tag="100" />
                            </StackPanel>
                            <TextBlock Text="type up to 1000" Style="{StaticResource HintText}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderBrushSoft}" Margin="0,16,0,14" />

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Variance" Style="{StaticResource FieldLabel}"
                                       HorizontalAlignment="Left" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Human-like" FontSize="12" Margin="0,0,10,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HumanVariance}"
                                          ToolTip="Derive the variance from the rate automatically" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Slider Grid.Column="0" x:Name="VarianceSlider" Style="{StaticResource AccentSlider}"
                                    Minimum="0" Maximum="50" SmallChange="0.5" LargeChange="2"
                                    IsEnabled="{Binding VarianceEditable}"
                                    VerticalAlignment="Center" Margin="0,0,16,0"
                                    ValueChanged="VarianceSlider_ValueChanged" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="±" FontSize="15" FontWeight="SemiBold" Margin="0,0,4,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                                <TextBox x:Name="VarianceBox" Style="{StaticResource NumericBox}" Width="56"
                                         MaxLength="6" IsEnabled="{Binding VarianceEditable}"
                                         Text="{Binding VarianceText, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewKeyDown="VarianceBox_PreviewKeyDown"
                                         LostFocus="VarianceBox_LostFocus" />
                                <TextBlock Text="CPS" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding RangeText}" Style="{StaticResource HintText}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Hold mode -->
                <TextBlock Text="HOLD MODE" Style="{StaticResource SectionLabel}" Margin="2,18,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource HintText}" Margin="0,0,60,0"
                                       Text="Repeats for as long as you keep the hotkey held down." />
                            <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      VerticalAlignment="Top" IsChecked="{Binding HoldEnabled}" />
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Hold this" Style="{StaticResource FieldLabel}" />
                            <ToggleButton Grid.Column="1" x:Name="HoldTriggerButton"
                                          Style="{StaticResource CaptureButton}"
                                          Content="{Binding HoldTriggerName}"
                                          IsEnabled="{Binding HoldEnabled}"
                                          Checked="Capture_Checked" Unchecked="Capture_Unchecked" Tag="HoldTrigger" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Repeat this" Style="{StaticResource FieldLabel}" />
                            <ToggleButton Grid.Column="1" x:Name="HoldActionButton"
                                          Style="{StaticResource CaptureButton}"
                                          Content="{Binding HoldActionName}"
                                          IsEnabled="{Binding HoldEnabled}"
                                          Checked="Capture_Checked" Unchecked="Capture_Unchecked" Tag="HoldAction" />
                        </Grid>

                        <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0"
                                   Foreground="{StaticResource Accent}"
                                   Text="Hotkey and repeated key are the same â€” results may be unreliable."
                                   Visibility="{Binding HoldConflict, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <!-- Toggle mode -->
                <TextBlock Text="TOGGLE MODE" Style="{StaticResource SectionLabel}" Margin="2,18,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource HintText}" Margin="0,0,60,0"
                                       Text="Tap the hotkey to switch repeating on, tap again to stop." />
                            <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      VerticalAlignment="Top" IsChecked="{Binding ToggleEnabled}" />
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tap this" Style="{StaticResource FieldLabel}" />
                            <ToggleButton Grid.Column="1" x:Name="ToggleTriggerButton"
                                          Style="{StaticResource CaptureButton}"
                                          Content="{Binding ToggleTriggerName}"
                                          IsEnabled="{Binding ToggleEnabled}"
                                          Checked="Capture_Checked" Unchecked="Capture_Unchecked" Tag="ToggleTrigger" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Repeat this" Style="{StaticResource FieldLabel}" />
                            <ToggleButton Grid.Column="1" x:Name="ToggleActionButton"
                                          Style="{StaticResource CaptureButton}"
                                          Content="{Binding ToggleActionName}"
                                          IsEnabled="{Binding ToggleEnabled}"
                                          Checked="Capture_Checked" Unchecked="Capture_Unchecked" Tag="ToggleAction" />
                        </Grid>

                        <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0"
                                   Foreground="{StaticResource Accent}"
                                   Text="Hotkey and repeated key are the same â€” results may be unreliable."
                                   Visibility="{Binding ToggleConflict, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <!-- Footer -->
                <Grid Margin="2,16,2,0">
                    <TextBlock Style="{StaticResource HintText}">
                        <Run Text="Emergency stop:" />
                        <Run Text="Ctrl + Alt + P" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Text="Esc cancels key capture" Style="{StaticResource HintText}"
                               HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>

